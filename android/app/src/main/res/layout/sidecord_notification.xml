<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sidecord_notification_root"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <ImageView
        android:id="@+id/sidecord_notification_icon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@mipmap/ic_launcher" />

    <TextView
        android:id="@+id/sidecord_notification_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="SideCord Activated"
        android:textColor="#202331"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/sidecord_notification_add"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:background="@drawable/notification_add_button_bg"
        android:clickable="true"
        android:ellipsize="end"
        android:focusable="true"
        android:gravity="center"
        android:maxLines="1"
        android:maxWidth="104dp"
        android:minWidth="88dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="이모티콘 추가"
        android:textColor="#2764D8"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/sidecord_notification_send"
        android:layout_width="72dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/notification_send_button_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:maxLines="1"
        android:text="전송"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
